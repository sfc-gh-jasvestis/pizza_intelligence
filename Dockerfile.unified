FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y curl supervisor && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
COPY supervisord-pizza.conf /etc/supervisor/conf.d/supervisord.conf
EXPOSE 8510 8511 8512
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:8510/_stcore/health && curl -f http://localhost:8511/_stcore/health && curl -f http://localhost:8512/_stcore/health || exit 1
CMD ["supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
