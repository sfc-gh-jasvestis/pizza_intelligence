# Streamlit secrets configuration for Pizza Ops Assistant
# Copy this file to secrets.toml and fill in your credentials

[connections.snowflake]
account = "YOUR_ACCOUNT_IDENTIFIER"   # e.g., "ABC12345" (without .snowflakecomputing.com)
user = "YOUR_USERNAME"
password = "YOUR_PASSWORD"
warehouse = "COMPUTE_WH"
database = "PIZZA_INTELLIGENCE"
schema = "ANALYTICS"
role = "ACCOUNTADMIN"

# Optional: Set account for Cortex API calls
[snowflake]
account = "YOUR_ACCOUNT_IDENTIFIER"   # Same as above
